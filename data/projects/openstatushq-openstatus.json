    "learningPath": {
      "thirtyMinutes": {
        "objective": "建立仓库地图而不陷入细节",
        "steps": [
          "阅读 README 的 About、Tooling 和 Tech Stack",
          "对照 package.json 与 pnpm-workspace.yaml 列出应用和共享包",
          "选定“创建监控器”作为唯一跟踪用例"
        ],
        "outcome": "产出一张不超过十个节点的系统边界图。"
      },
      "twoHours": {
        "objective": "通过可控切片理解一个业务对象",
        "steps": [
          "阅读仪表盘监控器列表与创建页",
          "找到对应的数据 Schema 和 API 边界",
          "查看 Go 检查器如何取得与执行任务",
          "记录哪些事实进入状态页"
        ],
        "outcome": "能说清监控器对象在 UI、API、数据库和 worker 中的表达。"
      },
      "oneDay": {
        "objective": "独立复刻一个迷你监控纵向样片",
        "steps": [
          "只保留单地区 HTTP 检查、一个存储和一个状态页",
          "实现创建监控器和定时执行",
          "记录响应码与延迟并生成最小历史",
          "测试 DNS 失败、超时、HTTP 5xx 与 worker 重试"
        ],
        "outcome": "得到一个不复制大型基础设施、却保留核心闭环的学习版监控器。"
      }
    },

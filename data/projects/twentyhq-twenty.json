      "ui",
      "agent-workflow",
      "project-organization"
    ],
    "difficulty": {
      "level": "hard",
      "rationale": "CRM 领域、元数据引擎、GraphQL/API、权限、后台任务和数据迁移形成大型 Nx monorepo，不适合整仓复制。",
      "prerequisites": [
        "TypeScript/React 中大型项目经验",
        "NestJS 基础",
        "PostgreSQL 与迁移概念",
        "RBAC/多租户基础"
      ]
    },

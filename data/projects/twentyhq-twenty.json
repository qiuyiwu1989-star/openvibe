    "learningPath": {
      "thirtyMinutes": {
        "objective": "建立 CRM 对象地图",
        "steps": [
          "读 README Stack",
          "选 company/person/opportunity 之一",
          "在 front/server 中各定位一次"
        ],
        "outcome": "一张对象从 metadata 到 UI 的图。"
      },
      "twoHours": {
        "objective": "设计一个自定义字段切片",
        "steps": [
          "定义字段类型与校验",
          "对照 API 输入输出",
          "找到表格和编辑器组件",
          "列出迁移、索引和权限影响"
        ],
        "outcome": "一份跨层改动清单。"
      },
      "oneDay": {
        "objective": "实现简化可配置 CRM 原型",
        "steps": [
          "仅支持两种对象和三种字段",
          "实现元数据驱动表格",
          "加入租户边界和背景导入任务",
          "测试迁移、批量操作和跨租户访问"
        ],
        "outcome": "一个能解释 metadata 价值与成本的小型 CRM。"
      }
    },

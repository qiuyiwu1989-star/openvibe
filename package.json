{
  "name": "openvibe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "catalog:materialize": "tsx scripts/evaluate/materialize-catalog.ts",
    "catalog:approve": "tsx scripts/publish/approve-catalog.ts",
    "discover": "tsx scripts/discover/cli.ts",
    "ingest": "tsx scripts/ingest/cli.ts",
    "updates:scan": "tsx scripts/updates/scan-cli.ts",
    "updates:review": "tsx scripts/updates/review-cli.ts",
    "publish:local": "tsx scripts/publish/approve-project.ts",
    "typecheck": "tsc --noEmit",
    "validate:fixtures": "tsx packages/schema/src/validate-fixtures.ts",
    "validate:snapshots": "tsx scripts/ingest/validate-snapshots.ts",
    "validate:candidates": "tsx scripts/evaluate/validate-candidates.ts",
    "test:schema": "tsx --test packages/schema/src/schemas.test.ts",
    "test:discover": "tsx --test scripts/discover/discover.test.ts",
    "test:ingest": "tsx --test scripts/ingest/ingest.test.ts",
    "test:updates": "tsx --test scripts/updates/updates.test.ts",
    "test:data": "tsx --test tests/data-integrity.test.ts",
    "test:ops": "tsx --test scripts/ops/ops.test.ts",
    "ops:validate": "bash -n scripts/ops/*.sh",
    "ops:smoke": "bash scripts/ops/smoke-test.sh",
    "ops:latency": "bash scripts/ops/latency-test.sh",
    "test": "npm run typecheck && npm run validate:fixtures && npm run test:schema && npm run test:discover && npm run test:ingest && npm run test:updates && npm run test:data && npm run test:ops && npm run ops:validate"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
